# Copy to config/local.env — never commit private paths or BAMs.

WORK_DIR="/path/to/work"
THREADS=32

GENOME_FA="/path/to/vitis.hap.fa"
GENOME_SOFT="/path/to/vitis.hap.softmasked.fa"

# RNA
RNA_BAM="/path/to/aligned.rna.bam"
ISOSEQ_BAM="/path/to/isoseq.bam"

# Draft engines
DRAFT_ENGINE="braker3"
DRAFT_ENGINE_B="gemoma"                 # gemoma|eviann|galba|helixer|liftoff|none
COMPLEASM_LINEAGE="eudicots"
OMARK_OUT="$WORK_DIR/omark"
PROTEIN_DB="/path/to/OrthoDB_eudicots.faa"
REF_FA="/path/to/PN40024.fa"
REF_GFF="/path/to/PN40024.gff3"
DRAFT_GFF="$WORK_DIR/draft/primary.gff3"
DRAFT_GFF_B="$WORK_DIR/draft/secondary.gff3"

# Merge
MERGE_MODE="evm"                        # tsebra|evm|evi_backbone
MERGED_GFF="$WORK_DIR/draft/merged.gff3"

# Proteins + QC
PROTEINS_FA="$WORK_DIR/proteins.faa"
BUSCO_LINEAGE="viridiplantae_odb12"
BUSCO_OUT="$WORK_DIR/busco_prot"
PSAURON_TSV="$WORK_DIR/psauron.tsv"
PRIORITY_TSV="$WORK_DIR/priority.tsv"
AGAT_OUT="$WORK_DIR/agat"

CURATED_GFF="$WORK_DIR/curated.gff3"
RELEASE_TAG="vitis_ann.v0.1"
