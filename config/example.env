# Copy to config/local.env — do not commit private paths.

WORK_DIR="/path/to/work"
GENOME_FA="/path/to/vitis.hap.fa"
DRAFT_GFF="/path/to/draft.gff3"          # from plant-gene-annotation
PROTEINS_FA="/path/to/proteins.fa"       # one representative CDS→protein per gene
THREADS=16

# BUSCO
BUSCO_LINEAGE="viridiplantae_odb12"      # or embryophyta_odb10 / eudicots_odb10
BUSCO_OUT="$WORK_DIR/busco_prot"

# PSAURON
PSAURON_TSV="$WORK_DIR/psauron.tsv"

# Priority / release
PRIORITY_TSV="$WORK_DIR/priority.tsv"
CURATED_GFF="$WORK_DIR/curated.gff3"
RELEASE_TAG="vitis_ann.v0.1"
